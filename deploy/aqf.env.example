# Configurazione del servizio: copiata in /etc/aqf/aqf.env da installa.sh.
AQF_HOST=127.0.0.1
AQF_PORT=8790
# Database e «disco interno» predefinito per i documenti.
AQF_DATA_DIR=/var/lib/aqf
AQF_WEB_DIR=/opt/aqf/web/dist
# Limite per un singolo file caricato. Il tunnel Cloudflare gratuito taglia a 100 MB.
AQF_MAX_UPLOAD_MB=95
AQF_SESSION_DAYS=30
NODE_ENV=production
